doctype html
html(lang='en')
  head
    // Required meta tags
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
    title Smart Call Service
    // plugins:css
    link(rel='stylesheet', href='assets/vendors/mdi/css/materialdesignicons.min.css')
    link(rel='stylesheet', href='assets/vendors/css/vendor.bundle.base.css')
    // endinject
    // Plugin css for this page
    link(rel='stylesheet', href='assets/vendors/jvectormap/jquery-jvectormap.css')
    link(rel='stylesheet', href='assets/vendors/flag-icon-css/css/flag-icon.min.css')
    link(rel='stylesheet', href='assets/vendors/owl-carousel-2/owl.carousel.min.css')
    link(rel='stylesheet', href='assets/vendors/owl-carousel-2/owl.theme.default.min.css')
    // End plugin css for this page
    // inject:css
    // endinject
    // Layout styles
    link(rel='stylesheet', href='assets/css/style.css')
    link(rel='stylesheet', href='assets/css/smartcall.css')
    // End layout styles
    link(rel='shortcut icon', href='assets/images/favicon-smartcall.svg')
  body
    .container-scroller
      // partial:partials/_sidebar.html
      nav#sidebar.sidebar.sidebar-offcanvas
        .sidebar-brand-wrapper.d-none.d-lg-flex.align-items-center.justify-content-center.fixed-top
          a.sidebar-brand.brand-logo(href='/')
            img(src='assets/images/smartcall-logo.svg', alt='logo')
          a.sidebar-brand.brand-logo-mini(href='/')
            img(src='assets/images/smartcall-mark.svg', alt='logo')
        ul.nav
          li.nav-item.profile
            .profile-desc
              .profile-pic
                .count-indicator
                  span.sc-avatar #{(user && user.name ? user.name : "?").charAt(0).toUpperCase()}
                  span.count.bg-success
                .profile-name
                  h5.mb-0.font-weight-normal #{user.name}
                  span #{user.role}
          li.nav-item.nav-category
            span.nav-link Bo&apos;limlar
          li.nav-item.menu-items.active
            a.nav-link(href='/')
              span.menu-icon
                i.mdi.mdi-speedometer
              span.menu-title Asosiy panel
          if user.bolimlar.task || user.bolimlar.role || user.bolimlar.user
            li.nav-item.menu-items
              a.nav-link(data-toggle='collapse', href='#ui-basic', aria-expanded='false', aria-controls='ui-basic')
                span.menu-icon
                  i.mdi.mdi-laptop
                span.menu-title Admin bo&apos;limi
                i.menu-arrow
              #ui-basic.collapse
                ul.nav.flex-column.sub-menu
                  if user.bolimlar.task
                    li.nav-item
                      a.nav-link(href='/task') Vazifalar
                  if user.bolimlar.role
                    li.nav-item
                      a.nav-link(href='/role') Rollar
                  if user.bolimlar.user
                    li.nav-item
                      a.nav-link(href='/user') Foydalanuvchilar
          if user.bolimlar.device
            li.nav-item.menu-items
              a.nav-link(href='/device')
                span.menu-icon
                  i.mdi.mdi-memory
                span.menu-title Qurilmalar
          
      // partial
      .container-fluid.page-body-wrapper
        // partial:partials/_navbar.html
        nav.navbar.p-0.fixed-top.d-flex.flex-row
          .navbar-brand-wrapper.d-flex.d-lg-none.align-items-center.justify-content-center
            a.navbar-brand.brand-logo-mini(href='/')
              img(src='./assets/images/smartcall-mark.svg', alt='logo')
          .navbar-menu-wrapper.flex-grow.d-flex.align-items-stretch
            button.navbar-toggler.navbar-toggler.align-self-center(type='button', data-toggle='minimize')
              span.mdi.mdi-menu
            ul.navbar-nav.navbar-nav-right
              li.nav-item.dropdown
                a#profileDropdown.nav-link(href='#', data-toggle='dropdown')
                  .navbar-profile
                    span.sc-avatar #{(user && user.name ? user.name : "?").charAt(0).toUpperCase()}
                    p.mb-0.d-none.d-sm-block.navbar-profile-name #{user.name}
                    i.mdi.mdi-menu-down.d-none.d-sm-block
                .dropdown-menu.dropdown-menu-right.navbar-dropdown.preview-list(aria-labelledby='profileDropdown')
                  h6.p-3.mb-0 Profil
                  .dropdown-divider
                  a.dropdown-item.preview-item
                    .preview-thumbnail
                      .preview-icon.bg-dark.rounded-circle
                        i.mdi.mdi-settings.text-success
                    .preview-item-content
                      p.preview-subject.mb-1 Sozlamalar
                  .dropdown-divider
                  a(href="/signout").dropdown-item.preview-item
                    .preview-thumbnail
                      .preview-icon.bg-dark.rounded-circle
                        i.mdi.mdi-logout.text-danger
                    .preview-item-content
                      p.preview-subject.mb-1 Hisobdan chiqish
                  .dropdown-divider
            button.navbar-toggler.navbar-toggler-right.d-lg-none.align-self-center(type='button', data-toggle='offcanvas')
              span.mdi.mdi-format-line-spacing
        // partial
        .main-panel
          .content-wrapper
            .sc-page-head
              div
                h1.sc-page-title Asosiy panel
                p.sc-page-sub #{new Date().toLocaleDateString('uz-UZ', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}
              if stats && stats.nextRing
                .sc-next
                  span.sc-next-label Keyingi qo&apos;ng&apos;iroq
                  strong.sc-num #{stats.nextRing.time}
                  span.sc-next-name #{stats.nextRing.name}
            .row.sc-kpis
              .col-xl-3.col-sm-6.grid-margin.stretch-card
                .card.sc-kpi
                  .card-body
                    .sc-kpi-icon: i.mdi.mdi-bell-ring-outline
                    .sc-kpi-value.sc-num #{stats.today.length}
                    .sc-kpi-label Bugungi qo&apos;ng&apos;iroqlar
                    .sc-kpi-note #{stats.today.filter(function (r) { return r.done; }).length} tasi o&apos;tdi, #{stats.today.filter(function (r) { return !r.done; }).length} tasi kutilmoqda
              .col-xl-3.col-sm-6.grid-margin.stretch-card
                .card.sc-kpi
                  .card-body
                    .sc-kpi-icon: i.mdi.mdi-calendar-check
                    .sc-kpi-value.sc-num #{stats.ringsActive}
                      span.sc-kpi-of  / #{stats.ringsTotal}
                    .sc-kpi-label Faol jadvallar
                    .sc-kpi-note #{stats.ringsTotal - stats.ringsActive} tasi o&apos;chirilgan
              .col-xl-3.col-sm-6.grid-margin.stretch-card
                .card.sc-kpi
                  .card-body
                    .sc-kpi-icon: i.mdi.mdi-memory
                    .sc-kpi-value.sc-num #{stats.devices}
                    .sc-kpi-label Qurilmalar
                    .sc-kpi-note Hisobingizga ulangan
              .col-xl-3.col-sm-6.grid-margin.stretch-card
                .card.sc-kpi
                  .card-body
                    .sc-kpi-icon: i.mdi.mdi-history
                    .sc-kpi-value.sc-num #{actions.length}
                    .sc-kpi-label Bugungi harakatlar
                    .sc-kpi-note Tizim jurnalidan
            .row
              .col-lg-5.grid-margin.stretch-card
                .card
                  .card-body
                    h4.card-title Bugungi jadval
                    if stats.today.length
                      ul.sc-timeline
                        each r in stats.today
                          li(class=r.done ? 'is-done' : (stats.nextRing && stats.nextRing.id === r.id ? 'is-next' : ''))
                            span.sc-time.sc-num #{r.time}
                            span.sc-tl-body
                              strong #{r.name}
                              small #{stats.deviceNames[r.iddevice] || 'Qurilma'}
                            if r.done
                              span.badge.sc-badge.sc-badge-muted O&apos;tdi
                            else if stats.nextRing && stats.nextRing.id === r.id
                              span.badge.sc-badge.sc-badge-accent Keyingi
                            else
                              span.badge.sc-badge.sc-badge-info Kutilmoqda
                    else
                      p.sc-empty Bugun uchun faol qo&apos;ng&apos;iroq yo&apos;q.
              .col-lg-7.grid-margin.stretch-card
                .card
                  .card-body
                    h4.card-title Bugungi harakatlar
                    .table-responsive.sc-scroll
                      table.table
                        thead
                          tr
                            th &numero;
                            th Xodim
                            th Bo&apos;lim
                            th Tafsif
                            th Vaqt
                        tbody
                          - for (var x = 0; x < actions.length; x++)
                            tr
                              td.sc-num #{x+1}
                              td #{actions[x].user}
                              td
                                span.badge.sc-badge.sc-badge-info #{actions[x].module}
                              td #{actions[x].description}
                              td.sc-num #{String(actions[x].time).replace(/:$/, '')}
                          if !actions.length
                            tr
                              td(colspan=5).sc-empty Bugun harakatlar yo&apos;q
          // content-wrapper ends
          // partial:partials/_footer.html
          footer.footer
          // partial
        // main-panel ends
      // page-body-wrapper ends
    // container-scroller
    // plugins:js
    script(src='assets/vendors/js/vendor.bundle.base.js')
    // endinject
    // Plugin js for this page
    script(src='assets/vendors/chart.js/Chart.min.js')
    script(src='assets/vendors/progressbar.js/progressbar.min.js')
    script(src='assets/vendors/jvectormap/jquery-jvectormap.min.js')
    script(src='assets/vendors/jvectormap/jquery-jvectormap-world-mill-en.js')
    script(src='assets/vendors/owl-carousel-2/owl.carousel.min.js')
    // End plugin js for this page
    // inject:js
    script(src='assets/js/off-canvas.js')
    script(src='assets/js/hoverable-collapse.js')
    script(src='assets/js/misc.js')
    script(src='assets/js/settings.js')
    script(src='assets/js/todolist.js')
    // endinject
    // Custom js for this page
    script(src='assets/js/dashboard.js')
    // End custom js for this page