doctype html
html(lang='uz')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    meta(http-equiv='X-UA-Compatible' content='ie=edge')
    title Smart Call Service
    link(rel='shortcut icon', href='../assets/images/favicon-smartcall.svg')
    link(rel='stylesheet' href='../assets/css/smartcall.css')
  body.sc-login-body
    main.sc-login
      section.sc-login-hero(aria-hidden='true')
        img.sc-login-logo(src='../assets/images/smartcall-logo.svg' alt='Smart Call Service')
        h2 Qo&apos;ng&apos;iroq jadvallarini bitta joydan boshqaring
        p Qurilmalar, jadval va xodimlar huquqlari &mdash; sodda va ishonchli boshqaruv paneli.
        ul
          li Qurilmalar va qo&apos;ng&apos;iroq jadvali
          li Rollar va vazifalar bo&apos;yicha ruxsatlar
          li Kunlik harakatlar jurnali
      section.sc-login-card
        h1 Kirish
        p.sc-login-sub Hisobingiz bilan tizimga kiring
        if error
          .sc-login-error(role='alert') #{error}
        form(action='/login' method='POST')#login.register-form
          label.sc-field
            span Telefon yoki e-pochta
            input#login(type='text' name='login' placeholder='+998 90 123 45 67' autocomplete='username' autofocus)
          label.sc-field
            span Parol
            input#password(type='password' name='password' placeholder='Parolingiz' autocomplete='current-password')
          label.sc-check(for='remember')
            input#remember.agree-term(type='checkbox' name='remember')
            span Meni eslab qol
          input.sc-btn-primary(type='submit' name='signin' value='Kirish')
